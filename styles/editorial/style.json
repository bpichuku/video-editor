{
  "name": "editorial",
  "status": "starter",
  "formats": ["long-form"],
  "colors": {
    "bg": "$bg",
    "rule": "$rule",
    "accent": "$accent",
    "accent_soft": "$accent-soft",
    "ink": "$ink",
    "muted": "$muted"
  },
  "fonts": {
    "display": "Fredoka",
    "caption": "Nunito",
    "caption_weight": 900
  },
  "captions": {
    "enabled": false,
    "reason": "Long form: YouTube serves its own, burn-ins clutter 16:9. Enable only on request.",
    "position": "lower-third",
    "max_words_per_line": 4,
    "highlight": "accent"
  },
  "hook": {
    "behaviour": "text-card-over-first-footage",
    "start_s": 0.0,
    "duration_s": 2.5,
    "text_source": "brand.md#default-hook-text"
  },
  "graphics": {
    "safe_zone": { "format": "1920x1080", "title_safe_margin_pct": 10, "outro_clear_right_pct": 40 },
    "allowed_kinds": ["stat", "card", "screenshot", "takeover", "zoom", "diagram", "broll-slot"],
    "default_density": "text-forward",
    "pip": { "geometry": null, "note": "Not applicable until a talking-head reference exists" },
    "texture": { "paper_grain_opacity": 0.06, "background": "bg with subtle accent-soft vignette" },
    "entrance_stagger_s": 0.4
  },
  "audio": {
    "music_bed_db": -18,
    "music_ducking": false,
    "music_fade_in": false,
    "music_fade_out_s": 1.5,
    "sfx_db": -10,
    "keep_ambient_craft_sound": true
  },
  "learned": []
}
